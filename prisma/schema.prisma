generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  desc      String
  price     Float
  category  String
  tag       String?
  img       String
  amazon    Boolean  @default(false)
  createdAt DateTime @default(now())
}
